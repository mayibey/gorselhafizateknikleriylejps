{
  "expo": {
    "name": "MEVZU-JSPS",
    "slug": "gorsel-hafiza-jsps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mevzu-icon-1024.png",
    "scheme": "mevzu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mevzu-icon-1024.png"
    },
    "android": {
      "package": "com.mayibey.jsps",
      "adaptiveIcon": {
        "backgroundColor": "#1F3864",
        "foregroundImage": "./assets/images/mevzu-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37237509-6816-434d-b5d0-95bacad71797"
      }
    }
  }
}
